   "type": "text",
   "x": -740,
   "y": 1542,
   "width": 560,
   "height": 34,
   "text": "`[T, 4096]  weighted sum`"
  },
  {
   "id": "op54",
   "type": "text",
   "x": -160,
   "y": 1606,
   "width": 320,
   "height": 64,
   "text": "**sum** routed + gated shared",
   "color": "4"
  },
  {
