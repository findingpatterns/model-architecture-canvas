   "type": "text",
   "x": -740,
   "y": 1194,
   "width": 560,
   "height": 34,
   "text": "`x [T, 4096]`"
  },
  {
   "id": "op48",
   "type": "text",
   "x": -160,
   "y": 1258,
   "width": 320,
   "height": 80,
   "text": "**router** 4096 → 512, softmax → top-10  \nweights renormalised to sum 1  \n2.1M",
   "color": "4"
  },
  {
   "id": "t49",
   "type": "text",
   "x": -20,
   "y": 1378,
   "width": 40,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl50",
   "type": "text",
   "x": -740,
   "y": 1368,
   "width": 560,
   "height": 34,
   "text": "`expert ids + weights [T, 10]`"
  },
  {
   "id": "op51",
   "type": "text",
   "x": -160,
   "y": 1432,
   "width": 320,
   "height": 80,
   "text": "**10 routed experts** of 512  \nSwiGLU 4096→1024→4096, FP8  \n125.8M · active of 6.44B",
   "color": "4"
  },
  {
   "id": "t52",
   "type": "text",
   "x": -123,
   "y": 1552,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
