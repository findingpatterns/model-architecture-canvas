{
 "nodes": [
  {
   "id": "cap-btitle",
   "type": "text",
   "x": -1400,
   "y": -560,
   "width": 1300,
   "height": 190,
   "text": "# Nex-N2.5-Pro — one decoder layer  \nPre-norm residual block. The token mixer is **either** Gated DeltaNet (left, 45 layers) **or** gated softmax attention (right, 15 layers, every 4th); the MoE below is the same in all 60. Bars ∝ channels (0.06 px/channel). Shapes per token."
  },
  {
   "id": "cap-bsrc",
   "type": "text",
   "x": 100,
   "y": -560,
   "width": 1300,
   "height": 190,
   "text": "Traced from transformers `modeling_qwen3_5_moe.py` (Qwen3_5MoeGatedDeltaNet, Qwen3_5MoeAttention, Qwen3_5MoeSparseMoeBlock) and checked against the checkpoint's tensor names/shapes. Parameter counts are per layer. FP8 (block 128×128) tensors: down_proj, gate_proj, up_proj of the routed experts."
  },
  {
   "id": "t1",
   "type": "text",
   "x": -123,
   "y": -320,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl2",
   "type": "text",
   "x": 180,
   "y": -330,
   "width": 560,
   "height": 34,
   "text": "`h [T, 4096]  residual stream in`"
  },
  {
   "id": "op3",
   "type": "text",
   "x": -160,
   "y": -266,
   "width": 320,
   "height": 64,
   "text": "**RMSNorm** (input_layernorm)",
   "color": "3"
  },
  {
   "id": "t4",
   "type": "text",
   "x": -123,
   "y": -162,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl5",
   "type": "text",
   "x": 180,
   "y": -172,
   "width": 560,
   "height": 34,
   "text": "`x [T, 4096]`"
  },
  {
   "id": "op6",
   "type": "text",
   "x": -880,
   "y": -78,
   "width": 320,
   "height": 64,
   "text": "**in_proj_qkv** 4096 → 12288  \n50.3M",
   "color": "#22d3ee"
  },
  {
   "id": "t7",
   "type": "text",
   "x": -1080,
   "y": 26,
   "width": 720,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl8",
   "type": "text",
   "x": -1660,
   "y": 16,
   "width": 560,
   "height": 34,
   "text": "`[T, 12288] = q 2048 · k 2048 · v 8192` — bar clipped (real 737px)"
  },
  {
   "id": "op9",
   "type": "text",
   "x": -880,
   "y": 80,
   "width": 320,
   "height": 64,
   "text": "**causal conv1d** (k=4, per channel) + SiLU",
   "color": "#22d3ee"
  },
  {
   "id": "t10",
   "type": "text",
   "x": -1080,
   "y": 184,
   "width": 720,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl11",
   "type": "text",
   "x": -1660,
   "y": 174,
   "width": 560,
   "height": 34,
   "text": "`q,k [T, 16, 128] · v [T, 64, 128]` — bar clipped (real 737px)"
  },
  {
   "id": "op12",
   "type": "text",
   "x": -880,
   "y": 238,
   "width": 320,
   "height": 64,
   "text": "**L2-norm q, k**; repeat 16 → 64 heads",
   "color": "#22d3ee"
  },
  {
   "id": "t13",
   "type": "text",
   "x": -1080,
   "y": 342,
   "width": 720,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl14",
   "type": "text",
   "x": -1660,
   "y": 332,
   "width": 560,
   "height": 34,
   "text": "`q,k,v [T, 64, 128]` — bar clipped (real 1475px)"
  },
  {
   "id": "op15",
   "type": "text",
   "x": -880,
   "y": 396,
   "width": 320,
   "height": 96,
   "text": "**gated delta rule**  \nS ← α·S(I − β k kᵀ) + β v kᵀ,  o = S q  \nstate S [64, 128, 128] per layer",
   "color": "#22d3ee"
  },
  {
   "id": "t16",
   "type": "text",
   "x": -966,
   "y": 532,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl17",
   "type": "text",
   "x": -1546,
   "y": 522,
   "width": 560,
   "height": 34,
   "text": "`o [T, 64, 128]`"
  },
  {
   "id": "op18",
   "type": "text",
   "x": -880,
   "y": 586,
   "width": 320,
   "height": 64,
   "text": "**gated RMSNorm** per head  \nnorm(o) · SiLU(z)",
   "color": "#22d3ee"
  },
  {
   "id": "t19",
   "type": "text",
   "x": -966,
   "y": 690,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl20",
   "type": "text",
   "x": -1546,
   "y": 680,
   "width": 560,
   "height": 34,
   "text": "`[T, 8192]`"
  },
  {
   "id": "op21",
   "type": "text",
   "x": -880,
   "y": 744,
   "width": 320,
   "height": 64,
   "text": "**out_proj** 8192 → 4096  \n33.6M",
   "color": "#22d3ee"
  },
  {
   "id": "t22",
   "type": "text",
   "x": -843,
   "y": 848,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl23",
   "type": "text",
   "x": -1460,
   "y": 838,
   "width": 560,
   "height": 34,
   "text": "`[T, 4096]  mixer out`"
  },
  {
   "id": "gdn-ab",
   "type": "text",
   "x": -330,
   "y": 396,
   "width": 270,
   "height": 110,
   "text": "**in_proj_a, in_proj_b** (from x)  \nα = exp(−e^A_log · softplus(a + dt_bias))  \nβ = sigmoid(b)  · [T, 64] each",
   "color": "#22d3ee"
  },
  {
   "id": "gdn-z",
   "type": "text",
   "x": -330,
   "y": 586,
   "width": 270,
   "height": 64,
   "text": "**in_proj_z** (from x) → z [T, 8192]",
   "color": "#22d3ee"
  },
  {
   "id": "op24",
   "type": "text",
   "x": 560,
   "y": -78,
   "width": 320,
   "height": 64,
   "text": "**q_proj** 4096 → 16384  \n67.1M",
   "color": "#f97316"
  },
  {
   "id": "t25",
   "type": "text",
   "x": 360,
   "y": 26,
   "width": 720,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl26",
   "type": "text",
   "x": 1100,
   "y": 16,
   "width": 560,
   "height": 34,
   "text": "`[T, 32, 256+256] = query | gate` — bar clipped (real 983px)"
  },
  {
   "id": "op27",
   "type": "text",
   "x": 560,
   "y": 80,
   "width": 320,
   "height": 64,
   "text": "**split**; RMSNorm on q (per head)",
   "color": "#f97316"
  },
  {
   "id": "t28",
   "type": "text",
   "x": 474,
   "y": 184,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl29",
   "type": "text",
   "x": 986,
   "y": 174,
   "width": 560,
   "height": 34,
   "text": "`q [T, 32, 256]`"
  },
  {
   "id": "op30",
   "type": "text",
   "x": 560,
   "y": 238,
   "width": 320,
   "height": 80,
   "text": "**RoPE** on 64 of 256 dims  \n(M-RoPE t/h/w 11/11/10 pairs, θ=10 000 000)",
   "color": "#f97316"
  },
  {
   "id": "t31",
   "type": "text",
   "x": 474,
   "y": 358,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl32",
   "type": "text",
   "x": 986,
   "y": 348,
   "width": 560,
   "height": 34,
   "text": "`q [T, 32, 256]`"
  },
  {
   "id": "op33",
   "type": "text",
   "x": 560,
   "y": 412,
   "width": 320,
   "height": 80,
   "text": "**causal softmax attention**  \nGQA: 16 query heads share each K/V head",
   "color": "#f97316"
  },
  {
   "id": "t34",
   "type": "text",
   "x": 474,
   "y": 532,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl35",
   "type": "text",
   "x": 986,
   "y": 522,
   "width": 560,
   "height": 34,
   "text": "`[T, 8192]`"
  },
  {
   "id": "op36",
   "type": "text",
   "x": 560,
   "y": 586,
   "width": 320,
   "height": 64,
   "text": "**× sigmoid(gate)** per channel",
   "color": "#f97316"
  },
  {
   "id": "t37",
   "type": "text",
   "x": 474,
   "y": 690,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl38",
   "type": "text",
   "x": 986,
   "y": 680,
   "width": 560,
   "height": 34,
   "text": "`[T, 8192]`"
  },
  {
   "id": "op39",
   "type": "text",
   "x": 560,
   "y": 744,
   "width": 320,
   "height": 64,
   "text": "**o_proj** 8192 → 4096  \n33.6M",
   "color": "#f97316"
  },
  {
   "id": "t40",
   "type": "text",
   "x": 597,
   "y": 848,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl41",
   "type": "text",
   "x": 900,
   "y": 838,
   "width": 560,
   "height": 34,
   "text": "`[T, 4096]  mixer out`"
  },
  {
   "id": "att-kv",
   "type": "text",
   "x": 60,
   "y": 392,
   "width": 270,
   "height": 130,
   "text": "**k_proj, v_proj** (from x) 4096 → 2×256 each · 4.2M  \nRMSNorm + RoPE on k  \nKV cache: 1 024 values / token",
   "color": "#f97316"
  },
  {
   "id": "op42",
   "type": "text",
   "x": -160,
   "y": 942,
   "width": 320,
   "height": 64,
   "text": "**residual add**  \nh (layer input) + mixer out",
   "color": "#64748b"
  },
  {
   "id": "t43",
   "type": "text",
   "x": -123,
   "y": 1046,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl44",
   "type": "text",
   "x": 180,
   "y": 1036,
   "width": 560,
   "height": 34,
   "text": "`h [T, 4096]`"
  },
  {
   "id": "op45",
   "type": "text",
   "x": -160,
   "y": 1100,
   "width": 320,
   "height": 64,
   "text": "**RMSNorm** (post_attention_layernorm)",
   "color": "3"
  },
  {
   "id": "t46",
   "type": "text",
   "x": -123,
   "y": 1204,
   "width": 246,
   "height": 9,
   "text": "",
