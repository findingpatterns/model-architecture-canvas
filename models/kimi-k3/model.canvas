  {
   "id": "note-snap",
   "type": "text",
   "x": 540,
   "y": -97,
   "width": 1674,
   "height": 60,
   "text": "**pink** = AttnRes block start: L0, L12, …, L84 (every 12th layer) store a snapshot of the running sum before adding their own output."
  },
  {
   "id": "xo23",
   "type": "text",
   "x": -137,
   "y": 633,
   "width": 573,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl24",
