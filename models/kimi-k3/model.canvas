   "x": 0,
   "y": 851,
   "width": 300,
   "height": 56,
   "text": "**final RMSNorm**",
   "color": "3"
  },
  {
   "id": "xf29",
   "type": "text",
   "x": -137,
   "y": 947,
   "width": 573,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl30",
