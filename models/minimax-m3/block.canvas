   "width": 300,
   "height": 34,
   "text": "`x̂ [T, 6144]`"
  },
  {
   "id": "qp44",
   "type": "text",
   "x": -500,
   "y": -96,
   "width": 300,
   "height": 56,
   "text": "**q_proj** 6144 → 64×128  \n50.3M",
   "color": "1"
  },
  {
   "id": "q45",
   "type": "text",
   "x": -555,
   "y": 0,
   "width": 410,
   "height": 9,
