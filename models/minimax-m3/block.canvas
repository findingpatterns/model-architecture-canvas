   "y": -12,
   "width": 300,
   "height": 34,
   "text": "`q [T, 64, 128]`"
  },
  {
   "id": "qn47",
   "type": "text",
   "x": -500,
   "y": 49,
   "width": 300,
   "height": 56,
   "text": "**q_norm** per head (128) · **RoPE** on first 64 dims",
   "color": "1"
  },
  {
   "id": "qo48",
   "type": "text",
   "x": -555,
   "y": 145,
   "width": 410,
   "height": 9,
