   "y": 181,
   "width": 300,
   "height": 34,
   "text": "`block scores [T, 4, T/128]`"
  },
  {
   "id": "itop65",
   "type": "text",
   "x": -1250,
   "y": 242,
   "width": 300,
   "height": 56,
   "text": "local 1 block forced in · **top-16** blocks per head",
   "color": "5"
  },
  {
