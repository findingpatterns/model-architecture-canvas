   "y": 73,
   "width": 300,
   "height": 80,
   "text": "score = q_I,h · k_I (causal) · **max-pool** over 128-key blocks",
   "color": "5"
  },
  {
   "id": "isco63",
   "type": "text",
   "x": -1140,
   "y": 193,
   "width": 80,
   "height": 9,
