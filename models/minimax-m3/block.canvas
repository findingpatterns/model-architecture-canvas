   "text": "`block ids [T, 4, 16]`"
  },
  {
   "id": "att68",
   "type": "text",
   "x": -150,
   "y": 447,
   "width": 300,
   "height": 80,
   "text": "**block-sparse GQA attention** — 64 heads in 4 groups; each group reads its 16×128 picked keys",
   "color": "1"
  },
  {
   "id": "ao69",
   "type": "text",
   "x": -205,
