  },
  {
   "id": "note-lbl79",
   "type": "text",
   "x": -474,
   "y": 990,
   "width": 300,
   "height": 34,
   "text": "`ĥ [T, 6144]`"
  },
  {
   "id": "rt80",
   "type": "text",
   "x": -150,
   "y": 1051,
   "width": 300,
   "height": 80,
   "text": "**router** 6144→128 (F32), sigmoid · top-4 by score+bias · weights normalised  \n0.8M",
   "color": "4"
  },
  {
   "id": "shexp",
   "type": "text",
   "x": 350,
   "y": 1051,
   "width": 300,
   "height": 80,
   "text": "**shared expert** (always on)    \nSwiGLU-OAI 6144→3072→6144    \n56.6M",
   "color": "#22c55e"
  },
  {
   "id": "rid81",
   "type": "text",
   "x": -20,
   "y": 1171,
   "width": 40,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl82",
   "type": "text",
   "x": 170,
   "y": 1159,
   "width": 300,
   "height": 34,
   "text": "`4 expert ids + weights / token`"
  },
  {
   "id": "rex83",
   "type": "text",
   "x": -150,
   "y": 1220,
   "width": 300,
   "height": 80,
   "text": "**4 of 128 routed experts**, each SwiGLU-OAI 6144→3072→6144  \n56.6M · each · 7.25B all",
   "color": "4"
  },
  {
   "id": "sum84",
   "type": "text",
   "x": -150,
   "y": 1340,
   "width": 300,
   "height": 80,
   "text": "**Σ** weighted experts **×2.0** + shared expert, **+ residual**",
   "color": "#64748b"
  },
  {
   "id": "bout85",
   "type": "text",
   "x": -154,
   "y": 1460,
   "width": 307,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl86",
   "type": "text",
   "x": 174,
   "y": 1448,
   "width": 300,
   "height": 34,
   "text": "`x [T, 6144] → next layer`"
  },
  {
   "id": "note-kv",
   "type": "text",
   "x": 1150,
   "y": -116,
   "width": 520,
   "height": 150,
   "text": "GQA: 16 query heads share each K/V head, so the cache holds 1024 numbers per token per layer (+ 128 for the indexer key). The indexer has one head per KV group (4 = 4) and no value path; it only decides which key blocks the main attention may read."
  },
  {
   "id": "note-act",
   "type": "text",
   "x": 700,
   "y": 747,
   "width": 560,
   "height": 170,
   "text": "SwiGLU-OAI (experts, shared expert, dense FFN): gate clamped ≤ 7.0, up clamped to ±7.0, out = (up + 1) · gate · σ(1.702·gate). Experts store w1 = gate, w3 = up, w2 = down, each 3072×6144."
  }
 ],
