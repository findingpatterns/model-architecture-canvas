   "x": 1900,
   "y": 334,
   "width": 300,
   "height": 56,
   "text": "**1 gated-attention layer** + MoE  \n26.24B · 512 experts",
   "color": "#f59e0b"
  },
  {
   "id": "mhd24",
   "type": "text",
