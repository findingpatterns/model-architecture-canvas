   "type": "text",
   "x": -1060,
   "y": 964,
   "width": 440,
   "height": 34,
   "text": "`attn out [T, 2560]`"
  },
  {
   "id": "mq22",
   "type": "text",
   "x": 300,
   "y": 60,
   "width": 300,
   "height": 76,
   "text": "**q_proj** 2560 → 32 × 192  \n15.7M",
   "color": "6"
  },
  {
   "id": "mqt23",
   "type": "text",
