   "type": "text",
   "x": 170,
   "y": 1330,
   "width": 440,
   "height": 34,
   "text": "`h [T, 2560]`"
  },
  {
   "id": "router41",
   "type": "text",
   "x": -150,
   "y": 1394,
   "width": 300,
   "height": 76,
   "text": "**router** 2560 → 512, sigmoid + bias  \n8 groups → best 4 → top 8  \n1.3M",
   "color": "4"
  },
  {
   "id": "routed",
   "type": "text",
   "x": -600,
   "y": 1530,
   "width": 300,
   "height": 76,
   "text": "**8 routed experts** of 512  \nSwiGLU 2560→768→2560 · 5.9M each",
   "color": "#86efac"
  },
  {
   "id": "shared",
   "type": "text",
   "x": 300,
   "y": 1530,
   "width": 300,
   "height": 76,
   "text": "**1 shared expert** (always on)  \nSwiGLU 2560→768→2560 · 5.9M",
   "color": "4"
  },
  {
   "id": "mix42",
   "type": "text",
   "x": -150,
   "y": 1686,
   "width": 300,
   "height": 76,
   "text": "**Σ weights·experts × 2.5**  \n+ shared expert",
   "color": "4"
  },
  {
   "id": "add243",
   "type": "text",
   "x": -150,
   "y": 1802,
   "width": 300,
   "height": 76,
   "text": "**add residual**",
   "color": "#64748b"
  },
  {
   "id": "hout44",
   "type": "text",
   "x": -102,
   "y": 1918,
   "width": 205,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl45",
   "type": "text",
   "x": 170,
   "y": 1908,
   "width": 440,
   "height": 34,
   "text": "`h [T, 2560]  → next layer`"
  },
  {
   "id": "note-dense",
   "type": "text",
   "x": 640,
   "y": 1380,
   "width": 420,
   "height": 110,
   "text": "L0–1 replace the whole MoE block by one dense SwiGLU 2560→6144→2560 (47.2M per layer)."
  },
  {
   "id": "note-route",
   "type": "text",
   "x": -1080,
   "y": 1380,
   "width": 440,
   "height": 150,
   "text": "Expert choice uses sigmoid scores + a learned per-expert bias (load balancing, aux-loss-free); the 8 chosen weights are renormalised to sum 1 and scaled by 2.5. One expert is 5.9M; all 512 are 3.02B per layer."
  },
  {
   "id": "note-cache",
   "type": "text",
   "x": 1200,
   "y": 60,
   "width": 420,
   "height": 150,
   "text": "Decode memory per sequence: KDA keeps a 32×128×128 state + conv tails, constant in T. MLA caches 576 values per token per layer — only 7 of 42 layers grow with context."
  }
 ],
