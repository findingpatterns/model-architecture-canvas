   "type": "text",
   "x": 716,
   "y": 166,
   "width": 440,
   "height": 34,
   "text": "`q [T, 32, 128+64]  (nope + rope)`"
  },
  {
   "id": "mkva25",
   "type": "text",
   "x": 300,
   "y": 230,
   "width": 300,
   "height": 76,
   "text": "**kv_a** 2560 → 512 + 64, RMSNorm on 512  \n1.5M",
   "color": "6"
  },
  {
   "id": "mc26",
   "type": "text",
   "x": 427,
   "y": 346,
   "width": 46,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl27",
   "type": "text",
   "x": 620,
   "y": 336,
   "width": 440,
   "height": 34,
   "text": "`c_kv [T, 512] + k_rope [T, 64]  — the KV cache`"
  },
  {
   "id": "mrope28",
   "type": "text",
   "x": 300,
   "y": 400,
   "width": 300,
   "height": 76,
   "text": "**M-RoPE** on the 64 rope dims  \n(t/h/w 8/12/12)",
   "color": "6"
  },
  {
   "id": "mkvb29",
   "type": "text",
   "x": 300,
   "y": 516,
   "width": 300,
   "height": 76,
   "text": "**kv_b** 512 → 32 × (128 k + 128 v)  \n4.2M",
   "color": "6"
  },
  {
   "id": "mattn30",
   "type": "text",
   "x": 300,
   "y": 632,
   "width": 300,
   "height": 76,
   "text": "**softmax attention**, 32 heads, causal",
   "color": "6"
  },
  {
