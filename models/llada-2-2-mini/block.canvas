   "type": "text",
   "x": -610,
   "y": 1168,
   "width": 440,
   "height": 34,
   "text": "`scores [T, 256]`"
  },
  {
   "id": "bias32",
   "type": "text",
   "x": -150,
   "y": 1227,
   "width": 300,
   "height": 66,
   "text": "**+ expert_bias**    \n(used for picking only)",
   "color": "#38bdf8"
  },
  {
   "id": "blk33",
   "type": "text",
   "x": -210,
   "y": 1333,
   "width": 420,
   "height": 76,
   "text": "**block routing** — per 32-token block:    \nmax score over its tokens → keep top **48** of 256",
   "color": "#f59e0b"
  },
  {
   "id": "al34",
   "type": "text",
   "x": -2,
   "y": 1449,
   "width": 4,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl35",
   "type": "text",
   "x": -610,
   "y": 1439,
   "width": 440,
   "height": 34,
   "text": "`allowed experts [T/32, 48]`"
  },
  {
   "id": "tk36",
   "type": "text",
   "x": -210,
   "y": 1498,
   "width": 420,
   "height": 76,
   "text": "**per token top-8** among the 48 allowed    \nweights = scores / sum × 2.5",
   "color": "#38bdf8"
  },
  {
   "id": "ids37",
   "type": "text",
   "x": -20,
   "y": 1614,
   "width": 40,
   "height": 9,
   "text": "",
