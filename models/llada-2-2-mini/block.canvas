   "width": 440,
   "height": 34,
   "text": "`[T, 2048]`"
  },
  {
   "id": "gate29",
   "type": "text",
   "x": -150,
   "y": 1072,
   "width": 300,
   "height": 66,
   "text": "**router** 2048 → 256 (fp32)    \nsigmoid scores",
   "color": "#38bdf8"
  },
  {
   "id": "sc30",
   "type": "text",
   "x": -10,
   "y": 1178,
   "width": 20,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
