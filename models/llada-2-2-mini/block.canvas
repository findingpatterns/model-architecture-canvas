   "y": 180,
   "width": 440,
   "height": 34,
   "text": "`V [T, 4, 128]`"
  },
  {
   "id": "attn",
   "type": "text",
   "x": -260,
   "y": 461,
   "width": 520,
   "height": 116,
   "text": "**attention** (SDPA, scale 1/√128)    \nGQA: each of 4 KV heads serves 4 query heads    \n**not causal** — mask = block-causal: full inside a 32-token block, earlier blocks visible",
   "color": "5"
  },
  {
   "id": "ao17",
   "type": "text",
   "x": -82,
   "y": 617,
   "width": 164,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl18",
   "type": "text",
   "x": 170,
   "y": 607,
   "width": 440,
   "height": 34,
   "text": "`[T, 16·128]`"
  },
  {
   "id": "o19",
   "type": "text",
   "x": -150,
   "y": 666,
   "width": 300,
   "height": 56,
   "text": "**dense** (o-proj) 2048 → 2048  \n4.2M",
   "color": "5"
  },
