  },
  {
   "id": "fvn59",
   "type": "text",
   "x": 3490,
   "y": 589,
   "width": 300,
   "height": 72,
   "text": "**v = same k_proj output**  \nv_norm (no weight), no RoPE",
   "color": "3"
  },
  {
   "id": "fatt",
   "type": "text",
   "x": 2250,
   "y": 802,
   "width": 920,
   "height": 90,
   "text": "**attention** — 32 query heads share 4 KV heads (8:1 GQA), head 512, scale 1  \ncausal over the whole context",
   "color": "5"
  },
  {
   "id": "fao60",
   "type": "text",
   "x": 2200,
   "y": 952,
   "width": 400,
   "height": 9,
