  {
   "id": "att96",
   "type": "text",
   "x": -350,
   "y": 410,
   "width": 700,
   "height": 80,
   "text": "**attention** — 64 query heads share 16 KV heads (4:1)  \nscore = q·k / 128 + relative bias · causal window 512",
   "color": "5"
  },
  {
