   "y": 532,
   "width": 440,
   "height": 34,
   "text": "`o [T, 128×128 = 16384]`"
  },
  {
   "id": "oproj80",
   "type": "text",
   "x": -150,
   "y": 616,
   "width": 300,
   "height": 56,
   "text": "**o_proj** 16384 → 6144 (BF16)  \n100.7M",
   "color": "5"
  },
