   "type": "text",
   "x": 810,
   "y": 1118,
   "width": 440,
   "height": 34,
   "text": "`scores [T, 384] = sigmoid(logits)`"
  },
  {
   "id": "topk90",
   "type": "text",
   "x": 490,
   "y": 1182,
   "width": 300,
   "height": 76,
   "text": "**top-8** on scores + e_score_correction_bias  \n(bias only picks; weights use raw scores)",
   "color": "4"
  },
  {
