{
 "nodes": [
  {
   "id": "cap-btitle",
   "type": "text",
   "x": -1300,
   "y": -420,
   "width": 2600,
   "height": 150,
   "text": "# MiMo-V2.6-Pro — one decoder layer  \nPre-norm residual block: RMSNorm → attention → add → RMSNorm → MoE → add. Left column = **SWA** layer (60 of 70), right column = **GA** layer (10 of 70); the MoE half is identical in both. Grey bars = tensors (0.04 px/channel). Weights: attention qkv FP8, o_proj BF16, routed experts MXFP4."
  },
  {
   "id": "bh59",
   "type": "text",
   "x": -123,
   "y": -220,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl60",
   "type": "text",
   "x": 170,
   "y": -230,
   "width": 440,
   "height": 34,
   "text": "`h [T, 6144]  from the previous layer`"
  },
  {
   "id": "bn161",
   "type": "text",
   "x": -150,
   "y": -166,
   "width": 300,
   "height": 56,
   "text": "**input RMSNorm**",
   "color": "3"
  },
  {
   "id": "bx62",
   "type": "text",
   "x": -123,
   "y": -70,
   "width": 246,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl63",
   "type": "text",
   "x": 170,
   "y": -80,
   "width": 440,
   "height": 34,
   "text": "`x [T, 6144]`"
  },
  {
   "id": "qkv64",
   "type": "text",
   "x": -790,
   "y": 4,
   "width": 300,
   "height": 76,
   "text": "**SWA: fused qkv_proj**  \n6144 → 27136  \n166.7M",
   "color": "#94a3b8"
  },
  {
   "id": "qkvt65",
   "type": "text",
   "x": -1183,
   "y": 120,
   "width": 1085,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl66",
   "type": "text",
   "x": -1643,
   "y": 110,
   "width": 440,
   "height": 34,
   "text": "`q | k | v  [T, 24576 | 1536 | 1024]`"
  },
  {
   "id": "split67",
   "type": "text",
   "x": -790,
   "y": 174,
   "width": 300,
   "height": 76,
   "text": "**split heads**  \nq 128×192 · k 8×192 · v 8×128",
   "color": "#94a3b8"
  },
  {
   "id": "rope68",
   "type": "text",
   "x": -790,
   "y": 290,
   "width": 300,
   "height": 76,
   "text": "**partial RoPE** on 64 of 192 q/k dims  \nθ = 1e+04 · v × 0.612",
   "color": "#94a3b8"
  },
  {
   "id": "att69",
   "type": "text",
   "x": -790,
   "y": 406,
   "width": 300,
   "height": 96,
   "text": "**sliding-window attention**  \nwindow 128 · GQA 16:1  \n+ learned sink logit per head (128)",
   "color": "#94a3b8"
  },
  {
   "id": "ot70",
   "type": "text",
   "x": -968,
   "y": 542,
   "width": 655,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl71",
   "type": "text",
   "x": -1428,
   "y": 532,
   "width": 440,
   "height": 34,
   "text": "`o [T, 128×128 = 16384]`"
  },
  {
   "id": "qkv72",
   "type": "text",
