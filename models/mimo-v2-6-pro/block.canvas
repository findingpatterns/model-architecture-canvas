   "text": "`q | k | v  [T, 24576 | 1536 | 1024]`"
  },
  {
   "id": "split75",
   "type": "text",
   "x": 490,
   "y": 174,
   "width": 300,
   "height": 76,
   "text": "**split heads**  \nq 128×192 · k 8×192 · v 8×128",
   "color": "5"
  },
  {
   "id": "rope76",
   "type": "text",
   "x": 490,
   "y": 290,
   "width": 300,
   "height": 76,
   "text": "**partial RoPE** on 64 of 192 q/k dims  \nθ = 1e+07 · v × 0.612",
   "color": "5"
  },
  {
   "id": "att77",
   "type": "text",
   "x": 490,
   "y": 406,
   "width": 300,
   "height": 96,
   "text": "**global causal attention**  \nfull context (1M) · GQA 16:1  \nno sink logit",
   "color": "5"
  },
  {
   "id": "ot78",
   "type": "text",
   "x": 312,
   "y": 542,
   "width": 655,
   "height": 9,
