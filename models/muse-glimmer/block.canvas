{
 "nodes": [
  {
   "id": "cap-btitle",
   "type": "text",
   "x": -700,
   "y": -330,
   "width": 1500,
   "height": 150,
   "text": "# Muse Glimmer 30B — one decoder layer (L0–L51, all the same size: 483.9M)  \nGrey bars = tensors (0.05 px/channel), boxes = operations with their weights. Sandwich norms: each sub-block is wrapped by an RMSNorm before *and* after, then added to the residual. The four layer norms scale by (1 + w)."
  },
  {
   "id": "cap-blegend",
   "type": "text",
   "x": 900,
   "y": -330,
   "width": 900,
   "height": 150,
   "text": "Sliding layers (39): RoPE on q/k, causal window 2048.    \nFull layers (13, every 4th): **no RoPE** (NoPE), causal over the whole context.    \nEverything else is identical, so both types share this diagram."
  },
  {
   "id": "xin1",
   "type": "text",
   "x": -166,
   "y": 0,
   "width": 333,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl2",
   "type": "text",
   "x": 186,
   "y": -10,
   "width": 440,
   "height": 34,
   "text": "`x [T, 6656]  residual stream in`"
  },
