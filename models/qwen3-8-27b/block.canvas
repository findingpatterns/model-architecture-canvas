{
 "nodes": [
  {
   "id": "cap-btitle",
   "type": "text",
   "x": -1400,
   "y": -560,
   "width": 1300,
   "height": 150,
   "text": "# Qwen3.8-27B — one layer  \nEvery layer: RMSNorm → **token mixer** → +residual → RMSNorm → **SwiGLU FFN** → +residual. Left mixer is used by 48 layers (3 of every 4), right mixer by 16. Grey bars = tensors, length ∝ channels per token."
  },
  {
   "id": "cap-bnote",
   "type": "text",
   "x": 100,
   "y": -560,
   "width": 1300,
   "height": 150,
   "text": "RMSNorms here scale by (1 + w) with w stored zero-centred. Parameter counts in boxes are per layer (from safetensors shapes). DeltaNet heads: 16 for q/k, 48 for v, dim 128; attention heads: 24 q, 4 kv, dim 256."
  },
  {
   "id": "bx1",
   "type": "text",
   "x": -205,
   "y": -360,
   "width": 410,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl2",
   "type": "text",
   "x": 225,
   "y": -370,
   "width": 440,
   "height": 34,
   "text": "`x [T, 5120]  residual stream in`"
  },
  {
   "id": "bn13",
   "type": "text",
   "x": -150,
   "y": -306,
   "width": 300,
   "height": 56,
   "text": "**input RMSNorm**",
   "color": "3"
  },
  {
   "id": "bxh4",
   "type": "text",
   "x": -205,
   "y": -210,
   "width": 410,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl5",
   "type": "text",
   "x": 225,
   "y": -220,
   "width": 440,
   "height": 34,
   "text": "`x̂ [T, 5120]`"
  },
  {
   "id": "dqkv6",
   "type": "text",
   "x": -1250,
   "y": 24,
   "width": 300,
   "height": 56,
   "text": "**in_proj_qkv** 5120 → 10240  \n52.4M",
   "color": "#22d3ee"
  },
  {
   "id": "dt17",
   "type": "text",
   "x": -1510,
   "y": 120,
   "width": 819,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl8",
   "type": "text",
   "x": -1970,
   "y": 110,
   "width": 440,
   "height": 34,
   "text": "`qkv [T, 10240] = q 2048 · k 2048 · v 6144`"
  },
  {
   "id": "dconv9",
   "type": "text",
   "x": -1250,
   "y": 174,
   "width": 300,
   "height": 56,
   "text": "**causal conv1d** (4 taps, per channel) + SiLU  \n41K",
   "color": "#22d3ee"
  },
  {
   "id": "dsplit10",
   "type": "text",
   "x": -1250,
   "y": 270,
   "width": 300,
   "height": 56,
   "text": "**split heads** · L2-norm q, k  \nrepeat q, k 16 → 48 heads",
   "color": "#22d3ee"
  },
  {
   "id": "dt211",
   "type": "text",
   "x": -1837,
   "y": 366,
   "width": 1475,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl12",
   "type": "text",
   "x": -2297,
   "y": 356,
   "width": 440,
   "height": 34,
   "text": "`q, k, v [T, 48, 128] each`"
  },
  {
   "id": "drule13",
   "type": "text",
   "x": -1250,
   "y": 420,
   "width": 300,
   "height": 80,
   "text": "**gated delta rule** (per head)  \nS ← α·S ;  S ← S + k ⊗ β(v − Sᵀk) ;  o = Sᵀq",
   "color": "#22d3ee"
  },
  {
   "id": "dt314",
   "type": "text",
   "x": -1346,
   "y": 540,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl15",
   "type": "text",
   "x": -1806,
   "y": 530,
   "width": 440,
   "height": 34,
   "text": "`o [T, 48, 128]   state S [48, 128, 128]`"
  },
  {
   "id": "dgn16",
   "type": "text",
   "x": -1250,
   "y": 594,
   "width": 300,
   "height": 56,
   "text": "**gated RMSNorm** — norm(o) · SiLU(z)",
   "color": "#22d3ee"
  },
  {
   "id": "dt417",
   "type": "text",
   "x": -1346,
   "y": 690,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl18",
   "type": "text",
   "x": -1806,
   "y": 680,
   "width": 440,
   "height": 34,
   "text": "`[T, 6144]`"
  },
  {
   "id": "dout19",
   "type": "text",
   "x": -1250,
   "y": 744,
   "width": 300,
   "height": 56,
   "text": "**out_proj** 6144 → 5120  \n31.5M",
   "color": "#22d3ee"
  },
  {
   "id": "dt520",
   "type": "text",
   "x": -1305,
   "y": 840,
   "width": 410,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl21",
   "type": "text",
   "x": -1765,
   "y": 830,
   "width": 440,
   "height": 34,
   "text": "`[T, 5120]`"
  },
  {
   "id": "dab",
   "type": "text",
   "x": -350,
   "y": 300,
   "width": 300,
   "height": 100,
   "text": "**in_proj_a, in_proj_b** x̂ → 48 each  \nβ = σ(b) · α = exp(−e^A_log · softplus(a + dt_bias))  \n492K",
   "color": "#22d3ee"
  },
  {
   "id": "dz",
   "type": "text",
   "x": -350,
   "y": 554,
   "width": 300,
   "height": 76,
   "text": "**in_proj_z** x̂ → 6144  \n31.5M",
   "color": "#22d3ee"
  },
  {
   "id": "aqkv22",
   "type": "text",
   "x": 950,
   "y": 24,
   "width": 300,
   "height": 56,
   "text": "**q_proj** 5120 → 12288 · **k/v_proj** → 1024  \n73.4M",
   "color": "#f97316"
  },
  {
   "id": "at123",
   "type": "text",
   "x": 527,
   "y": 120,
   "width": 1147,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl24",
   "type": "text",
   "x": 1693,
   "y": 110,
   "width": 440,
   "height": 34,
   "text": "`q, gate [T, 24, 256] · k, v [T, 4, 256]`"
  },
  {
   "id": "arope25",
   "type": "text",
   "x": 950,
   "y": 174,
   "width": 300,
   "height": 80,
   "text": "**q_norm, k_norm** (RMSNorm per head)  \n**partial mRoPE** on 64 of 256 dims",
   "color": "#f97316"
  },
  {
   "id": "aatt26",
   "type": "text",
   "x": 950,
   "y": 294,
   "width": 300,
   "height": 80,
   "text": "**causal softmax attention**  \nGQA 24 q / 4 kv heads (6:1)",
   "color": "#f97316"
  },
  {
   "id": "at227",
   "type": "text",
   "x": 854,
   "y": 414,
   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl28",
   "type": "text",
   "x": 1366,
   "y": 404,
   "width": 440,
   "height": 34,
   "text": "`[T, 6144]`"
  },
  {
   "id": "agate29",
   "type": "text",
   "x": 950,
   "y": 468,
   "width": 300,
   "height": 56,
   "text": "**× sigmoid(gate)** — per-channel output gate",
   "color": "#f97316"
  },
  {
   "id": "at330",
   "type": "text",
   "x": 854,
   "y": 564,
   "width": 492,
   "height": 9,
