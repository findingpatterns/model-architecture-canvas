   "height": 34,
   "text": "`x [T, 6144]`"
  },
  {
   "id": "mblk39",
   "type": "text",
   "x": 3450,
   "y": 1532,
   "width": 300,
   "height": 84,
   "text": "**MTP decoder layer**  \nGated DSA · MoE top-8 of 256  \n10.05B",
   "color": "#e879f9"
  },
  {
   "id": "mhead40",
   "type": "text",
   "x": 3450,
   "y": 1656,
   "width": 300,
   "height": 56,
   "text": "**final_layernorm → lm head** (shared)",
   "color": "2"
  },
  {
   "id": "mdraft41",
   "type": "text",
   "x": 3580,
   "y": 1752,
   "width": 40,
   "height": 9,
   "text": "",
