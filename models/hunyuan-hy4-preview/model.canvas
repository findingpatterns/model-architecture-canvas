   "width": 492,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl23",
   "type": "text",
   "x": 1316,
   "y": 1222,
   "width": 440,
   "height": 34,
   "text": "`h [T, 4, 6144]  after L77`"
  },
  {
   "id": "hch24",
   "type": "text",
   "x": 900,
   "y": 1328,
   "width": 300,
   "height": 56,
   "text": "**hc_head** — sigmoid-weighted sum of 4 streams",
   "color": "1"
  },
