   "width": 300,
   "height": 34,
   "text": "`x̂ [T, 6144]`"
  },
  {
   "id": "qa37",
   "type": "text",
   "x": -500,
   "y": -96,
   "width": 300,
   "height": 56,
   "text": "**q_a_proj** 6144→2048 + RMSNorm  \n12.6M",
   "color": "1"
  },
  {
   "id": "cq38",
   "type": "text",
   "x": -401,
   "y": 0,
   "width": 102,
   "height": 9,
