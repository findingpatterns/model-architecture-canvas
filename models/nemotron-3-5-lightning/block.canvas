   "width": 440,
   "height": 34,
   "text": "`x [T, 64 heads, 64] · B, C [T, 8 groups, 128]`"
  },
  {
   "id": "scan48",
   "type": "text",
   "x": -150,
   "y": 524,
   "width": 300,
   "height": 96,
   "text": "**SSD scan** (chunks of 128)  \nh ← exp(Δ·A)·h + Δ·B·x  \ny = C·h + D·x",
