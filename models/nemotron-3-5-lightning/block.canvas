   "height": 56,
   "text": "**in_proj** 2688 → 10304  \n27.7M",
   "color": "#38bdf8"
  },
  {
   "id": "pj40",
   "type": "text",
   "x": -412,
   "y": 156,
   "width": 824,
   "height": 9,
   "text": "",
