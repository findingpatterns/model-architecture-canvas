   "x": 432,
   "y": 146,
   "width": 440,
   "height": 34,
   "text": "`[T, 10304] = z 4096 ‖ xBC 6144 ‖ dt 64`"
  },
  {
   "id": "conv42",
   "type": "text",
   "x": -150,
   "y": 210,
   "width": 300,
   "height": 70,
   "text": "**causal conv1d** on xBC — depthwise, kernel 4,  \nthen SiLU",
   "color": "#38bdf8"
  },
  {
   "id": "xbc43",
   "type": "text",
   "x": -246,
   "y": 320,
