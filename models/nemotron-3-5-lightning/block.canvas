{
 "nodes": [
  {
   "id": "cap-btitle",
   "type": "text",
   "x": -500,
   "y": -420,
   "width": 2900,
   "height": 110,
   "text": "# Nemotron 3.5 Lightning — one layer of each type  \nEach layer: `x + mixer(RMSNorm(x))`, with exactly one mixer. Shapes per token; T = sequence length. Parameter counts from the checkpoint (L0, L5, L1)."
  },
  {
   "id": "hd33",
   "type": "text",
   "x": -150,
   "y": -240,
   "width": 300,
   "height": 56,
   "text": "**Mamba-2 layer (L0)**  \n38.7M",
   "color": "#38bdf8"
  },
  {
   "id": "in34",
   "type": "text",
   "x": -108,
   "y": -144,
   "width": 215,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
