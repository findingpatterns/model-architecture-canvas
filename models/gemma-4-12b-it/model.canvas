   "height": 34,
   "text": "`[P, 3840]`"
  },
  {
   "id": "vpr21",
   "type": "text",
   "x": -630,
   "y": -394,
   "width": 300,
   "height": 90,
   "text": "**RMSNorm** (no weight) **→ Linear**  \n3840 → 3840  \n14.7M",
   "color": "#a78bfa"
  },
  {
   "id": "vt22",
   "type": "text",
   "x": -634,
