   "x": 2580,
   "y": 696,
   "width": 560,
   "height": 34,
   "text": "`block scores [T, T/4]  (causal)`"
  },
  {
   "id": "op55",
   "type": "text",
   "x": 2240,
   "y": 760,
   "width": 320,
   "height": 72,
   "text": "**top-512 blocks** = 2048 tokens  \n+ the unfinished last block",
