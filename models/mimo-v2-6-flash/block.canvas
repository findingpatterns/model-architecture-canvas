{
 "nodes": [
  {
   "id": "cap-btitle",
   "type": "text",
   "x": -1300,
   "y": -420,
   "width": 2600,
   "height": 150,
   "text": "# MiMo-V2.6-Flash — one decoder layer  \nPre-norm residual block: RMSNorm → attention → add → RMSNorm → MoE → add. Left column = **SWA** layer (39 of 48), right column = **GA** layer (9 of 48); the MoE half is identical in both. Grey bars = tensors (0.04 px/channel). Weights: attention qkv FP8, o_proj BF16, routed experts MXFP4."
  },
  {
   "id": "bh59",
   "type": "text",
   "x": -82,
   "y": -220,
   "width": 164,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl60",
   "type": "text",
   "x": 170,
   "y": -230,
   "width": 440,
   "height": 34,
   "text": "`h [T, 4096]  from the previous layer`"
  },
  {
   "id": "bn161",
   "type": "text",
   "x": -150,
   "y": -166,
   "width": 300,
   "height": 56,
   "text": "**input RMSNorm**",
   "color": "3"
  },
  {
   "id": "bx62",
   "type": "text",
   "x": -82,
   "y": -70,
   "width": 164,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl63",
   "type": "text",
   "x": 170,
   "y": -80,
   "width": 440,
   "height": 34,
   "text": "`x [T, 4096]`"
  },
  {
   "id": "qkv64",
   "type": "text",
   "x": -670,
   "y": 4,
   "width": 300,
   "height": 76,
   "text": "**SWA: fused qkv_proj**  \n4096 → 14848  \n60.8M",
   "color": "#94a3b8"
  },
  {
   "id": "qkvt65",
   "type": "text",
   "x": -817,
   "y": 120,
   "width": 594,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl66",
   "type": "text",
   "x": -1277,
   "y": 110,
   "width": 440,
   "height": 34,
   "text": "`q | k | v  [T, 12288 | 1536 | 1024]`"
  },
  {
   "id": "split67",
   "type": "text",
   "x": -670,
   "y": 174,
   "width": 300,
   "height": 76,
   "text": "**split heads**  \nq 64×192 · k 8×192 · v 8×128",
   "color": "#94a3b8"
  },
  {
   "id": "rope68",
   "type": "text",
   "x": -670,
   "y": 290,
   "width": 300,
   "height": 76,
   "text": "**partial RoPE** on 64 of 192 q/k dims  \nθ = 1e+04 · v × 0.707",
   "color": "#94a3b8"
  },
  {
   "id": "att69",
   "type": "text",
   "x": -670,
   "y": 406,
   "width": 300,
   "height": 96,
   "text": "**sliding-window attention**  \nwindow 128 · GQA 8:1  \n+ learned sink logit per head (64)",
   "color": "#94a3b8"
  },
  {
   "id": "ot70",
   "type": "text",
   "x": -684,
   "y": 542,
   "width": 328,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl71",
   "type": "text",
   "x": -1144,
   "y": 532,
   "width": 440,
   "height": 34,
   "text": "`o [T, 64×128 = 8192]`"
  },
  {
   "id": "qkv72",
   "type": "text",
   "x": 370,
   "y": 4,
   "width": 300,
   "height": 76,
   "text": "**GA: fused qkv_proj**  \n4096 → 13568  \n55.6M",
   "color": "5"
  },
  {
   "id": "qkvt73",
   "type": "text",
   "x": 249,
   "y": 120,
   "width": 543,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl74",
   "type": "text",
   "x": 811,
   "y": 110,
   "width": 440,
   "height": 34,
   "text": "`q | k | v  [T, 12288 | 768 | 512]`"
  },
  {
   "id": "split75",
   "type": "text",
   "x": 370,
   "y": 174,
   "width": 300,
   "height": 76,
   "text": "**split heads**  \nq 64×192 · k 4×192 · v 4×128",
   "color": "5"
  },
  {
   "id": "rope76",
   "type": "text",
   "x": 370,
   "y": 290,
   "width": 300,
   "height": 76,
   "text": "**partial RoPE** on 64 of 192 q/k dims  \nθ = 1e+07 · v × 0.707",
   "color": "5"
  },
  {
   "id": "att77",
   "type": "text",
   "x": 370,
   "y": 406,
   "width": 300,
   "height": 96,
   "text": "**global causal attention**  \nfull context (1M) · GQA 16:1  \nno sink logit",
   "color": "5"
  },
  {
   "id": "ot78",
   "type": "text",
   "x": 356,
   "y": 542,
   "width": 328,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl79",
   "type": "text",
   "x": 704,
   "y": 532,
   "width": 440,
   "height": 34,
   "text": "`o [T, 64×128 = 8192]`"
  },
  {
   "id": "oproj80",
   "type": "text",
   "x": -150,
   "y": 616,
   "width": 300,
   "height": 56,
   "text": "**o_proj** 8192 → 4096 (BF16)  \n33.6M",
   "color": "5"
  },
  {
   "id": "add181",
   "type": "text",
   "x": -150,
   "y": 712,
   "width": 300,
   "height": 56,
   "text": "**add residual** h + attn(x)",
   "color": "#64748b"
  },
  {
   "id": "bh282",
   "type": "text",
   "x": -82,
   "y": 808,
   "width": 164,
   "height": 9,
   "text": "",
