   "height": 34,
   "text": "`x [T, 4096]`"
  },
  {
   "id": "gate87",
   "type": "text",
   "x": 370,
   "y": 1032,
   "width": 300,
   "height": 56,
   "text": "**router** gate 4096 → 256 (BF16)  \n1.0M",
   "color": "4"
  },
  {
   "id": "sc88",
   "type": "text",
   "x": 515,
   "y": 1128,
   "width": 10,
   "height": 9,
   "text": "",
   "color": "#64748b"
  },
  {
   "id": "note-lbl89",
   "type": "text",
   "x": 690,
   "y": 1118,
   "width": 440,
   "height": 34,
   "text": "`scores [T, 256] = sigmoid(logits)`"
  },
  {
   "id": "topk90",
   "type": "text",
   "x": 370,
   "y": 1182,
   "width": 300,
   "height": 76,
   "text": "**top-8** on scores + e_score_correction_bias  \n(bias only picks; weights use raw scores)",
   "color": "4"
  },
  {
   "id": "norm91",
   "type": "text",
   "x": 370,
   "y": 1298,
   "width": 300,
   "height": 56,
   "text": "**renormalise** the 8 weights to sum 1",
   "color": "4"
  },
  {
   "id": "wt92",
   "type": "text",
   "x": 517,
   "y": 1394,
   "width": 6,
