  "scenes": {
    "neuroncore-detail": {
      "anchor": "neuroncore-die0",
      "offset": [1.5, 3.5, 1.6],
      "components": [
        {
          "id": "sbuf",
          "name": "SBUF (on-chip SRAM)",
          "group": "memory",
          "color": "#e0a33a",
          "geom": {
            "type": "box",
            "size": [3.2, 0.2, 2.2],
            "pos": [0, 0, 0]
          },
          "desc": "Software-managed scratchpad SRAM, 128 partitions × 224 KiB. DMA fills it with A/B tiles from HBM; the Tensor, Vector, Scalar and GpSimd engines all read/write it directly.",
          "specs": [
            {
              "label": "Size (per NeuronCore)",
              "value": "28 MiB (128 × 224 KiB)",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            }
          ],
          "role": "shared-memory"
        },
        {
          "id": "dge",
          "parent": "sbuf",
          "name": "DMA / Descriptor Generation Engine",
          "group": "io",
          "geom": {
            "type": "box",
            "size": [1.6, 0.15, 0.4],
            "pos": [-0.9, -0.25, 1.3]
          },
          "desc": "Hardware Descriptor Generation Engine (DGE): schedules asynchronous DMA copies of tensor tiles between HBM and SBUF on demand, without pre-built descriptor lists.",
          "role": "dma-engine"
        },
        {
          "id": "psum",
          "parent": "sbuf",
          "name": "PSUM",
          "group": "memory",
          "color": "#f0c060",
          "geom": {
            "type": "box",
            "size": [1.8, 0.2, 1.3],
            "pos": [0, 0.35, 0.6]
          },
          "desc": "Dedicated accumulator memory for the Tensor Engine, separate from SBUF — the NeuronCore analogue of a Tensor-Core accumulator buffer. Partial sums across the contraction dimension build up here instead of in general-purpose registers.",
          "specs": [
            {
              "label": "Size (per NeuronCore)",
              "value": "2 MiB",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            }
          ],
          "role": "tensor-memory"
        },
        {
          "id": "tensor-engine",
          "parent": "psum",
          "name": "Tensor Engine",
          "group": "compute",
          "color": "#2a58b8",
          "geom": {
            "type": "box",
            "size": [1.5, 0.35, 1.5],
            "pos": [-0.95, 0.75, -0.6]
          },
          "desc": "A 128×128 systolic array of PEs. The stationary operand (e.g. weights) loads into the array; the moving operand (activations) streams through and multiply-accumulates happen every cycle. For FP8, each PE does 2 multiply-adds per cycle, presenting an effective 256×128 array to the programmer.",
          "specs": [
            {
              "label": "Systolic array",
              "value": "128 rows × 128 columns of PEs",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            },
            {
              "label": "Dense TFLOPS (per NeuronCore)",
              "value": "158 FP8 / 79 BF16-FP16-TF32 / 20 FP32",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            },
            {
              "label": "Sparse TFLOPS (per NeuronCore)",
              "value": "316 FP8/BF16/FP16/TF32",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            }
          ],
          "role": "tensor-core"
        },
        {
          "id": "vector-engine",
          "parent": "psum",
          "name": "Vector Engine",
          "group": "compute",
          "color": "#4a8f6b",
          "geom": {
            "type": "box",
            "size": [0.9, 0.2, 0.7],
            "pos": [0.85, 0.7, -0.6]
          },
          "desc": "Executes reductions and elementwise ops across SBUF/PSUM: e.g. layernorm statistics, softmax normalization. 4× faster for select BF16/FP16 ops than NeuronCore-v2.",
          "specs": [
            {
              "label": "Throughput",
              "value": "1.0 TFLOPS FP32",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            }
          ],
          "role": "vector-engine"
        },
        {
          "id": "scalar-engine",
          "parent": "psum",
          "name": "Scalar Engine",
          "group": "compute",
          "color": "#7aa0e0",
          "geom": {
            "type": "box",
            "size": [0.9, 0.2, 0.7],
            "pos": [0.85, 0.7, 0.3]
          },
          "desc": "Accelerates elementwise and non-linear functions (activations, bias add) and supports bit-accurate tensor copies without intermediate casting — part of the matmul epilogue.",
          "role": "scalar-engine"
        },
        {
          "id": "gpsimd-engine",
          "parent": "sbuf",
          "name": "GpSimd Engine",
          "group": "control",
          "geom": {
            "type": "box",
            "size": [0.3, 0.15, 0.3],
            "pos": [-1.5, 0.2, -0.95]
          },
          "repeat": {
            "count": [8, 1, 1],
            "step": [0.4, 0, 0]
          },
          "desc": "8 fully programmable processors running arbitrary C/C++ custom operators that don't map to the Tensor/Vector/Scalar engines, each with its own integrated DMA.",
          "specs": [
            {
              "label": "Integrated DMA bandwidth (total)",
              "value": "307 GB/s",
              "source": "https://awsdocs-neuron.readthedocs-hosted.com/en/latest/nki/guides/architecture/trainium2_arch.html"
            }
          ],
          "role": "gpsimd-engine"
        }
      ]
    }
  },
  "flows": [
    {
      "id": "hbm-to-die0",
      "from": "hbm-dram-die0",
