        {
          "id": "tmem",
          "parent": "smem",
          "name": "Tensor Memory (TMEM)",
          "group": "memory",
          "color": "#f0c060",
          "geom": {
            "type": "box",
            "size": [3.4, 0.2, 2.4],
            "pos": [0, 0.35, 0]
          },
          "desc": "New in Blackwell: dedicated memory where Tensor Cores keep their accumulators instead of registers. Frees registers for other work and allows larger tiles.",
          "specs": [
            {
              "label": "Size (per SM)",
              "value": "256 KB (128 lanes × 512 columns × 32-bit)",
              "estimate": true
            }
          ],
          "role": "tensor-memory"
        },
        {
          "id": "tensor-core",
          "parent": "tmem",
          "name": "Tensor Core (5th gen)",
          "group": "compute",
          "color": "#2a58b8",
          "geom": {
            "type": "box",
            "size": [0.7, 0.35, 0.9],
            "pos": [-1.25, 0.75, -0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Multiplies whole matrix tiles in one `tcgen05.mma` instruction, with FP4/FP6/FP8/BF16 inputs and micro-tensor scaling. A single thread issues the MMA; two SMs can pair up for a larger MMA. Almost all AI FLOPs happen here.",
          "specs": [
            {
              "label": "New low-precision formats",
              "value": "FP4, FP6",
              "source": "https://www.nvidia.com/en-us/data-center/technologies/blackwell-architecture/"
            }
          ],
          "role": "tensor-core"
        },
        {
          "id": "register-file",
          "parent": "tmem",
          "name": "Register file",
          "group": "memory",
          "color": "#d07a40",
          "geom": {
            "type": "box",
            "size": [0.7, 0.25, 0.9],
            "pos": [-1.25, 0.7, 0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Per-thread registers — the fastest storage. One slice per SM sub-partition.",
          "specs": [
            {
              "label": "Size (per SM)",
              "value": "256 KB (4 × 64 KB)",
              "estimate": true
            }
          ],
          "role": "register-file"
        },
        {
          "id": "warp-scheduler",
          "parent": "register-file",
          "name": "Warp scheduler + CUDA cores",
          "group": "control",
          "geom": {
            "type": "box",
            "size": [0.7, 0.15, 0.9],
            "pos": [-1.25, 1, 0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Each cycle picks a ready warp (32 threads) to issue. Scalar CUDA cores (FP32/INT32) run the epilogue: bias, activation, quantization.",
          "role": "warp-scheduler"
        },
        {
          "id": "tma",
          "parent": "smem",
          "name": "TMA (Tensor Memory Accelerator)",
          "group": "io",
          "geom": {
            "type": "box",
            "size": [1.6, 0.15, 0.4],
            "pos": [-0.9, -0.25, 1.4]
          },
          "desc": "Copies whole multi-dimensional tensor tiles between L2/HBM and shared memory asynchronously, without spending threads.",
          "role": "tma"
        }
      ]
    }
  },
  "flows": [
    {
      "id": "hbm-to-die0",
