    "cu-detail": {
      "anchor": "xcd-left",
      "offset": [6, 4, 0],
      "components": [
        {
          "id": "lds",
          "name": "Local Data Share (LDS)",
          "group": "memory",
          "color": "#e0a33a",
          "geom": { "type": "box", "size": [2.6, 0.2, 2 ], "pos": [0, 0, 0] },
          "desc": "Programmable scratchpad shared by the wavefronts of a workgroup, equivalent role to shared memory on other GPUs. CDNA 4 grows LDS to 160 KB per CU (up from 64 KB on CDNA 3) and adds wider GLOBAL_LOAD_LDS transfers plus read-with-transpose, so A/B tiles land here ready for the Matrix Cores.",
          "specs": [
            { "label": "Size (per CU)", "value": "160 KB (up from 64 KB on CDNA 3)", "source": "https://chipsandcheese.com/p/amds-cdna-4-architecture-announcement" }
          ],
          "role": "shared-memory"
        },
        {
          "id": "l1-vector-cache",
          "parent": "lds",
          "name": "L1 vector cache",
          "group": "memory",
          "color": "#f0c060",
          "geom": { "type": "box", "size": [2.6, 0.15, 0.6], "pos": [0, 0.3, 1.3] },
          "desc": "Per-CU L1 cache for vector memory accesses, backed by the XCD's shared L2.",
          "specs": [
            { "label": "Size (per CU)", "value": "32 KB", "source": "https://chipsandcheese.com/p/amds-cdna-4-architecture-announcement" }
          ],
          "role": "l1-cache"
        },
        {
          "id": "matrix-core",
          "parent": "lds",
          "name": "Matrix Core (MFMA)",
          "group": "compute",
          "color": "#2a58b8",
          "geom": { "type": "box", "size": [0.55, 0.35, 0.8], "pos": [-0.9, 0.75, -0.5] },
          "repeat": { "count": [4, 1, 1], "step": [0.6, 0, 0] },
          "desc": "4 Matrix Cores per CU execute MFMA (Matrix Fused Multiply-Add) instructions on whole tiles. CDNA 4 adds native MXFP4/MXFP6 micro-scaled formats alongside FP8/FP16/BF16, roughly doubling per-CU low-precision throughput over CDNA 3. Almost all AI FLOPs happen here.",
          "specs": [
            { "label": "New low-precision formats", "value": "MXFP4, MXFP6 (plus FP8, FP16, BF16)", "source": "https://www.servethehome.com/amd-mi350-and-cdna-4-architecture-launched-with-rocm-7/" },
            { "label": "Dense MXFP4 (whole GPU)", "value": "~10.1 PFLOPS", "source": "https://inferencex.semianalysis.com/chips/mi355x" }
          ],
          "role": "tensor-core"
        },
        {
          "id": "accumulator",
          "parent": "matrix-core",
          "name": "Matrix accumulator registers (AGPRs)",
          "group": "memory",
          "color": "#d07a40",
          "geom": { "type": "box", "size": [0.55, 0.2, 0.8], "pos": [-0.9, 0.55, 0.5] },
          "repeat": { "count": [4, 1, 1], "step": [0.6, 0, 0] },
          "desc": "Dedicated accumulator register file (AccVGPRs) where the Matrix Core keeps running partial sums across the K dimension, separate from the general vector register file.",
          "role": "accumulator-register"
        },
        {
          "id": "vgpr",
          "parent": "accumulator",
          "name": "Vector register file (VGPRs)",
          "group": "memory",
          "color": "#d07a40",
          "geom": { "type": "box", "size": [0.55, 0.15, 0.8], "pos": [-0.9, 0.3, 0.5] },
          "repeat": { "count": [4, 1, 1], "step": [0.6, 0, 0] },
          "desc": "Per-wavefront vector registers. Final MFMA results are copied here for the epilogue.",
          "role": "register-file"
        },
        {
          "id": "scalar-alu",
          "parent": "vgpr",
          "name": "Scalar/vector ALU + scheduler",
          "group": "control",
          "geom": { "type": "box", "size": [0.55, 0.12, 0.8], "pos": [-0.9, 0.1, 0.5] },
          "repeat": { "count": [4, 1, 1], "step": [0.6, 0, 0] },
          "desc": "Issues wavefronts and runs the epilogue on scalar/vector ALUs: bias add, activation, quantization back to a storage format.",
