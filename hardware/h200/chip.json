    {
      "text": "2. Memory controllers read the HBM stacks.",
      "focus": ["mc-left"],
      "dot": "mc-left"
    },
    {
      "text": "3. Data lands in the 50 MB L2 cache.",
      "focus": ["l2"],
      "dot": "l2"
    },
    {
      "text": "4. TMA copies tiles into shared memory.",
      "focus": ["tma"],
      "dot": "tma",
