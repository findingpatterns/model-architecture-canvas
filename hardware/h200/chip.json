          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Multiplies matrix tiles per warpgroup instruction (wgmma), FP8 via the Transformer Engine. Accumulators live in registers — Hopper has no TMEM.",
          "specs": [
            {
              "label": "Low-precision format",
              "value": "FP8 (E4M3, E5M2)",
              "source": "https://developer.nvidia.com/blog/nvidia-hopper-architecture-in-depth/"
            }
          ],
          "role": "tensor-core"
        },
        {
          "id": "register-file",
          "parent": "smem",
          "name": "Register file",
          "group": "memory",
          "color": "#d07a40",
          "geom": {
            "type": "box",
            "size": [0.7, 0.25, 0.9],
            "pos": [-1.25, 0.45, 0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Per-thread registers. On Hopper they also hold Tensor Core accumulators.",
          "specs": [
            {
              "label": "Size (per SM)",
              "value": "256 KB (4 × 64 KB)",
              "estimate": true
            }
          ],
          "role": "register-file"
        },
        {
          "id": "warp-scheduler",
          "parent": "register-file",
          "name": "Warp scheduler + CUDA cores",
          "group": "control",
          "geom": {
            "type": "box",
            "size": [0.7, 0.15, 0.9],
            "pos": [-1.25, 0.75, 0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Each cycle picks a ready warp (32 threads) to issue. Scalar CUDA cores (FP32/INT32) run the epilogue: bias, activation, quantization.",
          "role": "warp-scheduler"
        },
        {
          "id": "tma",
          "parent": "smem",
          "name": "TMA (Tensor Memory Accelerator)",
          "group": "io",
          "geom": {
            "type": "box",
            "size": [1.6, 0.15, 0.4],
            "pos": [-0.9, -0.25, 1.4]
          },
          "desc": "Copies whole multi-dimensional tensor tiles between L2/HBM and shared memory asynchronously, without spending threads.",
          "role": "tma"
        }
      ]
    }
  },
  "flows": [
    {
      "id": "hbm-left",
      "from": "hbm-dram-left",
      "to": "die",
