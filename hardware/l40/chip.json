        {
          "id": "tensor-core",
          "parent": "smem",
          "name": "Tensor Core (4th gen)",
          "group": "compute",
          "color": "#2a58b8",
          "geom": {
            "type": "box",
            "size": [0.7, 0.35, 0.9],
            "pos": [-1.25, 0.3, -0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "4 Tensor Cores per SM (568 total). Adds FP8 support and hardware structural sparsity versus 3rd-gen (Ampere) Tensor Cores, so an FP8 matmul with a 2:4 sparse weight pattern runs at double the dense FP8 rate.",
          "specs": [
            {
              "label": "FP8 Tensor (dense / sparse)",
              "value": "362 / 724 TFLOPS",
              "source": "https://www.nvidia.com/content/dam/en-zz/Solutions/design-visualization/support-guide/NVIDIA-L40-Datasheet-January-2023.pdf"
            },
            {
              "label": "New precision vs. Ampere",
              "value": "FP8",
              "source": "https://www.nvidia.com/content/dam/en-zz/Solutions/design-visualization/support-guide/NVIDIA-L40-Datasheet-January-2023.pdf"
            }
          ],
          "role": "tensor-core"
        },
        {
          "id": "rt-core",
          "parent": "smem",
          "name": "RT Core (3rd gen)",
          "group": "compute",
          "color": "#7a3fb0",
          "geom": {
            "type": "box",
            "size": [0.9, 0.3, 0.7],
            "pos": [1.3, 0.3, -0.3]
          },
          "desc": "1 RT Core per SM, run in parallel with the Tensor Cores. Walks the bounding-volume hierarchy (BVH) and tests ray/triangle or ray/box intersections in fixed-function hardware, with opacity micromap and displaced micro-mesh support new in Ada.",
          "specs": [
            {
              "label": "RT Core performance (whole GPU)",
              "value": "209 TFLOPS",
              "source": "https://www.nvidia.com/content/dam/en-zz/Solutions/design-visualization/support-guide/NVIDIA-L40-Datasheet-January-2023.pdf"
            }
          ],
          "role": "rt-core"
        },
        {
