          "parent": "smem",
          "name": "Register file",
          "group": "memory",
          "color": "#d07a40",
          "geom": {
            "type": "box",
            "size": [0.7, 0.25, 0.9],
            "pos": [-1.25, 0.25, 0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Per-thread registers — the fastest storage, one slice per SM sub-partition. Tensor Core accumulators land here (Ada has no separate tensor-memory, unlike Blackwell).",
          "specs": [
            {
              "label": "Size (per SM)",
              "value": "256 KB (4 x 64 KB)",
              "estimate": true
            }
          ],
          "role": "register-file"
        },
        {
          "id": "warp-scheduler",
          "parent": "register-file",
          "name": "Warp scheduler + CUDA cores",
          "group": "control",
          "geom": {
            "type": "box",
            "size": [0.7, 0.15, 0.9],
            "pos": [-1.25, 0.55, 0.55]
          },
          "repeat": {
            "count": [4, 1, 1],
            "step": [0.83, 0, 0]
          },
          "desc": "Each cycle picks a ready warp (32 threads) to issue. Scalar CUDA (FP32/INT32) cores run the epilogue: bias, activation, quantization, and shading/compute work that isn't a matmul or a ray test.",
          "role": "warp-scheduler"
        }
      ]
    }
  },
  "flows": [
    {
      "id": "gddr-left-to-die",
