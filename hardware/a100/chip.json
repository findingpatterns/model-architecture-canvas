  "scenes": {
    "sm-detail": {
      "anchor": "sm-a",
      "offset": [1.5, 3.5, 1.6],
      "components": [
        {
          "id": "smem",
          "name": "L1 / Shared memory",
          "group": "memory",
          "color": "#e0a33a",
          "geom": { "type": "box", "size": [3.4, 0.2, 2.4], "pos": [0, 0, 0] },
          "desc": "Programmable, configurable scratchpad shared by the threads of a block. cp.async writes tiles here directly from L2/HBM; Tensor Cores read operands straight from here.",
          "specs": [
            {
              "label": "L1 + shared (per SM)",
              "value": "192 KB combined, up to 164 KB configurable as shared memory",
              "source": "https://www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/a100/pdf/nvidia-a100-datasheet-us-nvidia-1758950-r4-web.pdf"
